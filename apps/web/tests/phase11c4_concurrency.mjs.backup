/**
 * Phase 11C.4 — controlled LOCAL concurrency benchmark.
 *
 * FULL REPLACEMENT for apps/web/tests/phase11c4_concurrency.mjs
 * Run in C:\Projects\explainable-news-verifier\apps\web:
 *
 *   node tests/phase11c4_concurrency.mjs --diagnose
 *   node tests/phase11c4_concurrency.mjs --concurrency 2 --rounds 2
 *   node tests/phase11c4_concurrency.mjs --concurrency 2 --rounds 2 --execute
 *
 * IMPORTANT:
 * - Chrome must already be running with phase11c_chrome.ps1 -Mode Benchmark.
 * - Sign in using that launcher in -Mode Login, not Playwright or CDP.
 * - This script never reads/exports cookies, tokens, or account identifiers.
 * - It only issues browser-origin requests on http://localhost:3000.
 * - No authentication or quota bypasses, retries, or arbitrary external URLs.
 * - Leave Chrome's localhost tab open and don't navigate it during the test.
 */

import { chromium } from "@playwright/test";
import { mkdir, writeFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ORIGIN = "http://localhost:3000";
const CDP_ENDPOINT = "http://127.0.0.1:9237";
const SESSION_PATH = "/api/auth/session";
const VERIFY_PATH = "/api/verification";
const CLAIM = "The Eiffel Tower is located in Berlin, Germany.";
const EXPECTED_VERDICT = "REFUTING_EVIDENCE";
const TOP_K = 5;
const TIMEOUT_MS = 135_000;
const BETWEEN_WAVES_MS = 3_000;
const MAX_CONCURRENCY = 3;
const MAX_TOTAL = 8;

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const round = (value) =>
  typeof value === "number" && Number.isFinite(value)
    ? Math.round(value * 1000) / 1000
    : null;

function argumentsFromCli(argv) {
  const opts = { concurrency: 2, rounds: 2, execute: false, diagnose: false, help: false };
  for (let i = 0; i < argv.length; i++) {
    const flag = argv[i];
    if (flag === "--help" || flag === "-h") { opts.help = true; continue; }
    if (flag === "--execute" || flag === "--diagnose") {
      opts[flag.slice(2)] = true;
      continue;
    }
    if (flag === "--concurrency" || flag === "--rounds") {
      const value = argv[++i];
      if (!value || !/^[0-9]+$/.test(value)) throw new Error(`${flag} requires a positive integer`);
      opts[flag.slice(2)] = Number(value);
      continue;
    }
    throw new Error(`Unknown option: ${flag}`);
  }
  if (opts.diagnose && opts.execute) throw new Error("Use --diagnose OR --execute, not both.");
  if (!Number.isInteger(opts.concurrency) || opts.concurrency < 1 || opts.concurrency > MAX_CONCURRENCY) {
    throw new Error(`--concurrency must be 1-${MAX_CONCURRENCY}`);
  }
  if (!Number.isInteger(opts.rounds) || opts.rounds < 1 || opts.rounds * opts.concurrency > MAX_TOTAL) {
    throw new Error(`--rounds must be positive and planned requests <= ${MAX_TOTAL}`);
  }
  return opts;
}

function help() {
  console.log(`Phase 11C.4 — local authenticated concurrency test

Usage:
  node tests/phase11c4_concurrency.mjs --diagnose
  node tests/phase11c4_concurrency.mjs --concurrency 2 --rounds 2
  node tests/phase11c4_concurrency.mjs --concurrency 2 --rounds 2 --execute

--diagnose: Inspect connected Chrome contexts for an authenticated local tab. NO verification requests.
--execute: Explicitly authorize verification requests; absent by default.
--concurrency: 1-${MAX_CONCURRENCY}; --rounds: integer; maximum ${MAX_TOTAL} total requests.

Uses ${ORIGIN}, CDP ${CDP_ENDPOINT}. No cookie export, quota bypass or retries.`);
}

function summary(values) {
  const sorted = values.filter((v) => typeof v === "number" && Number.isFinite(v)).sort((a, b) => a - b);
  if (!sorted.length) {
    return { count: 0, mean_ms: null, min_ms: null, p50_ms: null, p95_ms: null, max_ms: null, method: "nearest-rank" };
  }
  const pct = (n) => sorted[Math.max(0, Math.ceil(sorted.length * n / 100) - 1)];
  return {
    count: sorted.length,
    mean_ms: round(sorted.reduce((a, b) => a + b, 0) / sorted.length),
    min_ms: round(sorted[0]),
    p50_ms: round(pct(50)),
    p95_ms: round(pct(95)),
    max_ms: round(sorted.at(-1)),
    method: "nearest-rank",
  };
}

function csvCell(value) {
  return `"${String(value ?? "").replaceAll('"', '""')}"`;
}

async function saveReport({ startedUtc, opts, records, waves, failure }) {
  const webDir = fileURLToPath(new URL("../", import.meta.url));
  const outputDir = path.resolve(webDir, "../../benchmarks/results");
  await mkdir(outputDir, { recursive: true });
  const stamp = startedUtc.replaceAll(/[-:.]/g, "");
  const prefix = path.join(outputDir, `phase11c4_concurrency_${stamp}`);
  const statuses = {};
  for (const record of records) {
    const key = String(record.http_status ?? "no-response");
    statuses[key] = (statuses[key] ?? 0) + 1;
  }
  const good = records.filter((record) => record.success);
  const report = {
    schema_version: 2,
    phase: "11C.4",
    scenario: "controlled authenticated simultaneous browser fetch requests",
    started_utc: startedUtc,
    ended_utc: new Date().toISOString(),
    origin: ORIGIN,
    concurrency: opts.concurrency,
    rounds_planned: opts.rounds,
    requests_planned: opts.concurrency * opts.rounds,
    requests_attempted: records.length,
    success_count: good.length,
    statuses,
    top_k: TOP_K,
    expected_verdict: EXPECTED_VERDICT,
    failure,
    browser_request_latency: summary(good.map((r) => r.elapsed_ms)),
    backend_inference_latency: summary(good.map((r) => r.backend_ms)),
    waves,
    records,
    notes: [
      "Uses an authenticated Chrome tab from the user's dedicated local test profile.",
      "No user identifiers, emails, cookies, tokens or evidence text are stored.",
      "HTTP 429 may indicate rate limiting or queue admission: inspect backend logs.",
      "No retries; a failing wave prevents additional waves.",
      "This small test is not a throughput or production p95 estimate.",
    ],
  };
  const fields = [
    "wave", "request", "http_status", "success", "verdict", "elapsed_ms",
    "backend_ms", "launch_offset_ms", "error_code", "transport_error",
  ];
  const csv = [
    fields.join(","),
    ...records.map((record) => fields.map((field) => csvCell(record[field])).join(",")),
  ].join("\n") + "\n";
  await writeFile(`${prefix}.json`, JSON.stringify(report, null, 2) + "\n", "utf8");
  await writeFile(`${prefix}_requests.csv`, csv, "utf8");
  return { report, json: `${prefix}.json`, csv: `${prefix}_requests.csv` };
}

function isLocalTab(page) {
  try {
    const url = new URL(page.url());
    return url.origin === ORIGIN && !page.isClosed();
  } catch { return false; }
}

/**
 * Importantly, evaluate from the ACTUAL tab's same-origin document.
 * Testing Chrome contexts[0].newPage() can check a different storage session
 * than a manually authenticated tab. We verify rather than assume.
 * Return only boolean auth state and HTTP status, never user data.
 */
async function sessionPreflight(page) {
  if (!isLocalTab(page)) {
    return { session_http_status: null, user_id_exists: false, reason: "wrong-origin-or-closed" };
  }
  try {
    return await page.evaluate(async () => {
      try {
        const response = await fetch("/api/auth/session", {
          method: "GET", credentials: "same-origin", cache: "no-store", redirect: "error",
        });
        const data = await response.json().catch(() => null);
        return {
          session_http_status: response.status,
          user_id_exists: typeof data?.user?.id === "string" && data.user.id.length > 0,
        };
      } catch (error) {
        return { session_http_status: null, user_id_exists: false, reason: error?.name ?? "fetch-error" };
      }
    });
  } catch (error) {
    return { session_http_status: null, user_id_exists: false, reason: error?.name ?? "page-evaluate-error" };
  }
}

/**
 * Look for an already authenticated localhost tab, across ALL CDP contexts.
 * If no existing tab qualifies, probe a new /verify tab inside each context.
 * Never read browser storage or copy authentication cookies.
 */
async function locateAuthenticatedPage(browser) {
  const contexts = browser.contexts();
  console.log(`Connected Chrome contexts: ${contexts.length}`);
  if (!contexts.length) throw new Error("Chrome exposed no browser contexts.");
  let localhostTabs = 0;
  for (let ci = 0; ci < contexts.length; ci++) {
    const context = contexts[ci];
    const pages = context.pages().filter(isLocalTab);
    localhostTabs += pages.length;
    console.log(`Context ${ci + 1}: ${pages.length} existing ${ORIGIN} tab(s)`);
    for (let pi = 0; pi < pages.length; pi++) {
      const page = pages[pi];
      const auth = await sessionPreflight(page);
      console.log(`  Existing tab ${pi + 1}: HTTP ${auth.session_http_status ?? "none"}; user ID exists: ${auth.user_id_exists}`);
      if (auth.session_http_status === 200 && auth.user_id_exists) {
        console.log(`Authenticated existing tab FOUND in context ${ci + 1}. Keeping that tab open.`);
        return { page, created: false, contextIndex: ci + 1 };
      }
    }
  }
  console.log(`No authenticated existing tab found (${localhostTabs} local tabs inspected).`);
  for (let ci = 0; ci < contexts.length; ci++) {
    let candidate;
    try {
      candidate = await contexts[ci].newPage();
      await candidate.goto(`${ORIGIN}/verify`, { waitUntil: "domcontentloaded", timeout: 30_000 });
      const auth = await sessionPreflight(candidate);
      console.log(`  New tab in context ${ci + 1}: HTTP ${auth.session_http_status ?? "none"}; user ID exists: ${auth.user_id_exists}`);
      if (auth.session_http_status === 200 && auth.user_id_exists) {
        console.log(`Authenticated new tab FOUND in context ${ci + 1}.`);
        return { page: candidate, created: true, contextIndex: ci + 1 };
      }
    } catch (error) {
      console.log(`  New tab in context ${ci + 1}: navigation/session probe failed (${error?.name ?? "Error"}).`);
    }
    if (candidate) await candidate.close().catch(() => {});
  }
  throw new Error(
    "No authenticated localhost tab/context was found via CDP. In the SAME dedicated benchmark Chrome, " +
    "open http://localhost:3000/api/auth/session and confirm a user.id, " +
    "then keep that tab open. Do not sign in through debug mode or disable authentication."
  );
}

async function executeWave(page, waveNumber, concurrency) {
  if (!isLocalTab(page)) throw new Error("Verified Chrome tab was closed or navigated off localhost:3000.");
  return page.evaluate(async ({ waveNumber, concurrency, claim, topK, timeoutMs, expected }) => {
    const beginning = performance.now();
    const tasks = Array.from({ length: concurrency }, (_, index) => (async () => {
      const started = performance.now();
      const row = {
        wave: waveNumber, request: index + 1, http_status: null, success: false,
        verdict: null, elapsed_ms: null, backend_ms: null,
        launch_offset_ms: Math.round((started - beginning) * 1000) / 1000,
        error_code: null, transport_error: null,
      };
      try {
        const response = await fetch("/api/verification", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ claim, top_k: topK }),
          redirect: "error", cache: "no-store",
          signal: AbortSignal.timeout(timeoutMs),
        });
        const data = await response.json().catch(() => null);
        row.http_status = response.status;
        row.verdict = typeof data?.verdict === "string" ? data.verdict : null;
        row.backend_ms = typeof data?.latency_ms === "number" && Number.isFinite(data.latency_ms)
          ? Math.round(data.latency_ms * 1000) / 1000 : null;
        row.error_code = typeof data?.code === "string" ? data.code : null;
        row.success = response.status === 200 && row.verdict === expected && row.backend_ms !== null;
      } catch (error) {
        row.transport_error = typeof error?.name === "string" ? error.name : "UnknownError";
      }
      row.elapsed_ms = Math.round((performance.now() - started) * 1000) / 1000;
      return row;
    })());
    const results = await Promise.all(tasks);
    return {
      wall_ms: Math.round((performance.now() - beginning) * 1000) / 1000,
      results,
    };
  }, { waveNumber, concurrency, claim: CLAIM, topK: TOP_K, timeoutMs: TIMEOUT_MS, expected: EXPECTED_VERDICT });
}

async function main() {
  const opts = argumentsFromCli(process.argv.slice(2));
  if (opts.help) { help(); return; }
  console.log("Phase 11C.4 — CONTROLLED LOCAL CONCURRENCY TEST (authenticated tab detection v2)");
  console.log(`Origin: ${ORIGIN}; CDP: ${CDP_ENDPOINT}`);
  console.log(`Plan: ${opts.rounds} rounds x ${opts.concurrency} concurrent = ${opts.rounds * opts.concurrency} planned requests`);
  console.log("Authentication, quotas, and backend queue limits remain enabled; no retries.");
  if (!opts.execute && !opts.diagnose) {
    console.log("DRY RUN: no requests. Use --diagnose to check session or --execute to run.");
    return;
  }

  const startedUtc = new Date().toISOString();
  const records = [];
  const waves = [];
  let failure = null;
  let browser;
  let selected;
  let authenticated = false;

  try {
    browser = await chromium.connectOverCDP(CDP_ENDPOINT, { timeout: 10_000 });
    selected = await locateAuthenticatedPage(browser);
    const check = await sessionPreflight(selected.page);
    console.log(`Selected tab preflight: session HTTP ${check.session_http_status}; User ID exists: ${check.user_id_exists}`);
    if (check.session_http_status !== 200 || !check.user_id_exists) {
      throw new Error("Authenticated tab lost its session before the test.");
    }
    authenticated = true;
    if (opts.diagnose) {
      console.log("AUTHENTICATION DIAGNOSIS PASSED. No verification requests sent.");
      return;
    }

    for (let wave = 1; wave <= opts.rounds; wave++) {
      if (wave > 1) await sleep(BETWEEN_WAVES_MS);
      const before = await sessionPreflight(selected.page);
      if (before.session_http_status !== 200 || !before.user_id_exists) {
        throw new Error(`Session unavailable before round ${wave}. Stopping without another request.`);
      }
      console.log(`\nWave ${wave}/${opts.rounds}: issuing ${opts.concurrency} simultaneous requests...`);
      const outcome = await executeWave(selected.page, wave, opts.concurrency);
      waves.push({ wave, wall_ms: round(outcome.wall_ms), requests: outcome.results.length });
      for (const item of outcome.results) {
        records.push(item);
        console.log(`  #${item.request}: HTTP ${item.http_status ?? "none"}; verdict=${item.verdict ?? "-"}; browser=${item.elapsed_ms ?? "-"}ms; backend=${item.backend_ms ?? "-"}ms; error=${item.error_code ?? item.transport_error ?? "-"}`);
      }
      if (outcome.results.some((r) => !r.success)) {
        failure = `Round ${wave} contained failed or rejected requests. No retries or additional waves.`;
        console.warn(failure);
        break;
      }
    }
  } catch (error) {
    failure = error instanceof Error ? error.message : "Unexpected benchmark error";
    console.error("Benchmark stopped:", failure);
  } finally {
    // Close only tabs CREATED BY THIS SCRIPT; leave authenticated user tabs open.
    if (selected?.created) await selected.page.close().catch(() => {});
    if (browser) await browser.close().catch(() => {});
    // Diagnose-only checks never generate verification reports.
    if (!opts.diagnose) {
      const saved = await saveReport({ startedUtc, opts, records, waves, failure });
      console.log("\n--- Phase 11C.4 report ---");
      console.log("JSON:", saved.json);
      console.log("CSV:", saved.csv);
      console.log(`Passed: ${saved.report.success_count}/${saved.report.requests_attempted} attempted (${saved.report.requests_planned} planned)`);
      console.log("HTTP statuses:", JSON.stringify(saved.report.statuses));
      console.log("Browser latency (ms):", JSON.stringify(saved.report.browser_request_latency));
      console.log("Backend latency (ms):", JSON.stringify(saved.report.backend_inference_latency));
    }
    if (failure || (opts.execute && records.filter((r) => r.success).length !== opts.rounds * opts.concurrency) || (opts.diagnose && !authenticated)) {
      process.exitCode = 1;
    }
  }
}

main().catch((error) => {
  console.error("Fatal error:", error instanceof Error ? error.message : "Unknown error");
  process.exitCode = 1;
});
